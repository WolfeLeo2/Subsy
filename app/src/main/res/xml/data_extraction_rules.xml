<?xml version="1.0" encoding="utf-8"?>
<!-- Subscription data (and, later, detected bank messages) stays on the device: no cloud backup.
     Device-to-device transfer is allowed so a phone migration keeps the user's data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
